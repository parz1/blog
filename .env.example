# Required for server-side GitHub project status. The app does not fall back to
# anonymous GitHub API requests.
NUXT_GITHUB_TOKEN=
# Optional alias if you use the conventional GitHub token name locally.
GITHUB_TOKEN=

# Article view counter. The Vercel Marketplace Upstash integration injects
# these credentials automatically. Without them, view counts stay hidden.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Blank means enabled only on Vercel Production. Set true for intentional local
# testing, or false to disable the counter even in production.
ARTICLE_VIEWS_ENABLED=

# Nuxt Studio GitHub OAuth
# Local dev uses the in-page Studio floating editor; /_studio is the production OAuth login route.
# GitHub OAuth callback:
#   https://YOUR_DOMAIN/__nuxt_studio/auth/github
# Local production-mode testing callback:
#   http://localhost:3000/__nuxt_studio/auth/github
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=

# Optional but recommended: restrict Studio access to these GitHub account emails.
# Leave empty only if repository write access is your only access control.
STUDIO_GITHUB_MODERATORS=

# Optional: publish Studio edits to another branch, for example "studio".
STUDIO_BRANCH_NAME=main

# Gallery media import/upload.
# R2 uses the S3-compatible endpoint documented by Cloudflare:
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
GALLERY_R2_ACCOUNT_ID=
GALLERY_R2_ENDPOINT=
GALLERY_R2_BUCKET=
GALLERY_R2_ACCESS_KEY_ID=
GALLERY_R2_SECRET_ACCESS_KEY=
# Optional for Cloudflare R2 temporary credentials.
GALLERY_R2_SESSION_TOKEN=

# Optional CDN/custom domain for generated public URLs.
GALLERY_R2_PUBLIC_BASE_URL=

# Public generated assets go here. They are stripped before upload: JPEG previews
# remove EXIF, and public Live videos are remuxed/transcoded to MP4 with metadata
# and chapters removed.
GALLERY_R2_PUBLIC_PREFIX=gallery/public

# Originals retain EXIF/QuickTime metadata. Keep this off unless the originals
# prefix is genuinely private and you want an archival copy in R2.
GALLERY_R2_ORIGINAL_PREFIX=gallery/originals
GALLERY_R2_UPLOAD_ORIGINALS=false

# Disabled by default to avoid publishing motion/audio casually. When enabled,
# the uploaded public object is a stripped MP4 at gallery/public/<id>/live.mp4,
# not the source MOV.
GALLERY_R2_UPLOAD_PUBLIC_LIVE=false

GALLERY_PREVIEW_DIR=public/gallery
GALLERY_PUBLIC_LIVE_DIR=.data/gallery-public-live
GALLERY_PREVIEW_SIZE=1800
GALLERY_MANIFEST_PATH=.data/gallery-media.json

# Optional external folio location (default: sibling ../folio).
# Used for local reading, the Koto pilot and local release creation.
CONTENT_WORKSPACE_DIR=

# External folio workspace. Empty uses the sibling ../folio locally.
# Development discovers Markdown automatically; production uses a validated release.
# BLOG_CONTENT_MODE=legacy is an explicit local rollback, never a missing-input fallback.
BLOG_CONTENT_MODE=
# CI: choose a local immutable JSON file OR a private HTTPS download, not both.
BLOG_CONTENT_RELEASE_FILE=
BLOG_CONTENT_RELEASE_URL=
# Required for URL downloads, recommended for CI files. Never use NUXT_PUBLIC_* here.
BLOG_CONTENT_RELEASE_SHA256=
# Runtime Delivery origin. Published content updates without a blog build.
# Build-time URL/SHA above remain the reviewed cold-start fallback baseline.
NUXT_FOLIO_ORIGIN=
# Optional explicit durable cache database; useful when preview DBs auto-branch.
# Runtime prefers existing Redis, then this URL / POSTGRES_URL / DATABASE_URL.
FOLIO_CACHE_DATABASE_URL=
# Online blog-content Delivery: use /api/v1/releases/<immutable ID> and the
# matching SHA-256 returned by scripts/check-content-delivery.mjs --origin https://SERVICE
# Publish credentials and database access belong exclusively to blog-content.

# CLI-only publishing target. pnpm content:publish defaults to the current Folio.
CONTENT_SERVICE_URL=https://folio-kohl-xi.vercel.app
# CLI-only credential: prefer the existing Windows DPAPI file in the workspace.
# Never set this as a Vercel blog variable or a NUXT_PUBLIC_* variable.
CONTENT_OWNER_TOKEN=

# Cloudflare Web Analytics public beacon token (not an API credential).
# Set on the preview Worker; leave blank to skip the beacon.
NUXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
